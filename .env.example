# ----------------------------------------------------------------------------
# AI Interview Coach — environment template
# Copy this file to `.env` and fill in the real values before running the app.
# ----------------------------------------------------------------------------

# Required: Google Generative AI API key.
# Used by app/agents/question_generator.py and app/agents/summary_generator.py
# via langchain-google-genai. Create one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-generative-ai-key-here

# Optional: OpenAI API key.
# Only needed if you swap any of the agents onto langchain-openai (the
# current default provider is Google Gemini through langchain-google-genai).
OPENAI_API_KEY=

# Optional: Whisper model size used by app/agents/answer_evaluator.py.
# Valid values: tiny, base, small, medium, large.
# Smaller = faster + lower VRAM; larger = better transcription accuracy.
WHISPER_MODEL=base

# Optional: uvicorn bind host/port overrides for deployment.
# Defaults match `uvicorn app.main:app --host 0.0.0.0 --port 8000`.
HOST=0.0.0.0
PORT=8000
