# Required: OpenAI API key used by langchain-openai for question generation,
# answer evaluation, and final-summary agents.
OPENAI_API_KEY=sk-replace-me

# Optional: override the chat model. Defaults to gpt-4o-mini in the agents.
# OPENAI_MODEL=gpt-4o-mini

# Optional: Whisper checkpoint used to transcribe spoken answers.
# Trade-off: tiny < base < small < medium < large in both quality and latency.
# WHISPER_MODEL=base

# Optional: language code for the gTTS question playback.
# TTS_LANG=en
