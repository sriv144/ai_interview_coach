# AI Interview Coach — environment template
#
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.
# Only OPENAI_API_KEY is strictly required to run the app end-to-end.

# --- LLM / Speech (required) -------------------------------------------------
# Used by `langchain-openai` for question generation, evaluation, and summary,
# and (optionally) by OpenAI Whisper if you wire it to the hosted API instead
# of the local model.
OPENAI_API_KEY=sk-replace-me

# --- LLM tuning (optional) ---------------------------------------------------
# Override the default chat model. Any chat-completions-compatible model id.
# OPENAI_MODEL=gpt-4o-mini

# Temperature for question generation and evaluation. Lower = more deterministic.
# OPENAI_TEMPERATURE=0.2

# --- Whisper (optional) ------------------------------------------------------
# Local Whisper model size. Tradeoff: accuracy vs. download size + latency.
# Valid values: tiny | base | small | medium | large
# WHISPER_MODEL=base

# --- Server (optional) -------------------------------------------------------
# Host/port for uvicorn when not passed on the command line.
# HOST=127.0.0.1
# PORT=8000

# --- Logging (optional) ------------------------------------------------------
# LOG_LEVEL=INFO
