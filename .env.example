# Required — used by langchain-openai for question generation, answer
# evaluation, and the final summary agent.
OPENAI_API_KEY=sk-replace-me

# Optional — override the chat model used by all three agents.
# Defaults to the LangChain `langchain-openai` default model.
# OPENAI_MODEL=gpt-4o-mini

# Optional — Whisper model size for transcribing user audio answers.
# Common choices: tiny, base, small, medium, large.
# Larger models are more accurate but slower and require more memory.
# WHISPER_MODEL=base

# Optional — language code used by gTTS for spoken interview questions.
# WHISPER_MODEL above controls the recognition language; this controls
# the synthesised voice.
# TTS_LANG=en
