# ---- AI Interview Coach environment configuration ----
# Copy this file to `.env` and fill in your credentials:
#   cp .env.example .env

# Google Gemini API key (REQUIRED).
# The question generator, answer evaluator, and final-summary generator all use
# Google's Gemini models (gemini-1.5-flash) through langchain-google-genai, and
# the app raises an error on startup if this is missing.
# Create a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
