# Required: LLM provider key used by langchain-openai for question generation,
# answer scoring, and the final summary.
OPENAI_API_KEY=sk-replace-me

# Optional: override the default chat model.
# OPENAI_MODEL=gpt-4o-mini

# Optional: Whisper model size used for local transcription.
# Options: tiny, base, small, medium, large
# WHISPER_MODEL=base

# Optional: Uvicorn bind host and port.
# HOST=127.0.0.1
# PORT=8000
