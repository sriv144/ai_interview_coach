# Required: Google Gemini API key.
# Used by all three LangChain agents in app/agents/.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: only set if you swap the agents to use OpenAI / a
# Cohere-compatible endpoint instead of Gemini. The langchain-openai
# dependency is already pinned in requirements.txt.
OPENAI_API_KEY=
