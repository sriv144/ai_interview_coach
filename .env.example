# AI Interview Coach environment template
# Copy to `.env` and fill in your own values. `.env` is git-ignored.

# Google Gemini API key (required).
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional: override the model used by question_generator / answer_evaluator /
# summary_generator. Defaults to gemini-1.5-flash-latest in code.
# GEMINI_MODEL=gemini-1.5-flash-latest

# Optional: server bind address for `python app/main.py` style local launches.
# HOST=0.0.0.0
# PORT=8000
