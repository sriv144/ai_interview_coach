# AI Interview Coach environment variables
# Copy to .env and fill in real values.

# --- LLM provider key (required) ---
# Used by app/agents/* for question generation, answer evaluation, and the final summary.
# All three agents call Google Gemini via langchain-google-genai.
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- Optional model overrides ---
# Override the Gemini model name (default: gemini-1.5-flash-latest).
# GEMINI_MODEL=gemini-1.5-flash-latest

# Override the local Whisper model size used for speech-to-text.
# Options: tiny, base, small, medium, large
# Smaller = faster + less accurate, larger = slower + more accurate.
# WHISPER_MODEL=base

# --- Optional language overrides ---
# Default voice + transcription language. Two-letter ISO code.
# INTERVIEW_LANG=en

# --- Server ---
# Host/port for uvicorn when launched from app.main directly.
# HOST=0.0.0.0
# PORT=8000
