# Copy to .env and fill in the values below.

# Required: OpenAI key used for question generation, answer evaluation, and summary.
OPENAI_API_KEY=sk-...

# Optional: override the chat model. Leave unset to use the per-agent defaults.
# OPENAI_MODEL=gpt-4o-mini

# Optional: Whisper model size used for local speech-to-text.
# One of: tiny, base, small, medium, large. Smaller is faster but less accurate.
# WHISPER_MODEL=base
