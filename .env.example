# OpenAI API key used by the LangChain agents (questions, evaluation, summary)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default chat model
# OPENAI_MODEL=gpt-4o-mini

# Optional: Whisper model size for local speech-to-text
# Smaller = faster, larger = more accurate. Defaults to base.
# WHISPER_MODEL=base

# Optional: logging verbosity
# LOG_LEVEL=INFO
