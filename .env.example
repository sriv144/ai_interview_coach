# Required: OpenAI API key used by langchain-openai for question generation
# and answer evaluation. Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Whisper model size for speech-to-text. One of:
#   tiny | base | small | medium | large
# Larger = slower transcription but better accuracy. Default: base.
WHISPER_MODEL=base

# Optional: bind address for the FastAPI server.
# HOST=0.0.0.0
# PORT=8000
