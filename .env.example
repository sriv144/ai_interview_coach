# OpenAI API key — used for both question generation and answer evaluation
OPENAI_API_KEY=sk-your-key-here

# Optional: override the chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Whisper model size — tiny | base | small | medium | large
# Larger = more accurate but slower and larger download
# WHISPER_MODEL=base
